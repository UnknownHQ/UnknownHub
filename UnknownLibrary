                elseif desc:IsA("UIStroke") then
                    TweenService:Create(desc, fadeInfo, { Transparency = 1 }):Play()
                end
            end

            task.delay(0.68, function()
                pcall(function() notifCard:Destroy() end)
            end)
        end

        dismissBtn.MouseButton1Click:Connect(closeCardSlowly)
