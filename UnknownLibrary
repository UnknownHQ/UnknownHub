    local function GetItemFromList(listName, parent, createIfMissing)
        local name = tostring(listName or "List")
        local existing = listRegistry[name]
        if existing then return existing end
        if createIfMissing == false then return nil end
        return CreateList(parent or contentArea, name, {})
    end

