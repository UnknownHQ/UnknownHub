        closeButton.Position = UDim2.new(0, 12, 1, -38)
        closeButton.BackgroundColor3 = Color3.fromRGB(40, 46, 60)
        closeButton.Text = "Dismiss"
        closeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        closeButton.Font = Enum.Font.GothamBold
        closeButton.TextSize = 11
        closeButton.AutoButtonColor = false
        closeButton.ZIndex = 122
        closeButton.Parent = panel
        applyCorner(closeButton, 6)

        copyButton.MouseButton1Click:Connect(function()
            copyButton.Text = copyText(lastError) and "Copied!" or "Clipboard Error"
            task.delay(1.2, function()
                if copyButton and copyButton.Parent then copyButton.Text = "Copy Error" end
            end)
        end)

        closeButton.MouseButton1Click:Connect(function()
            if errorOverlay then errorOverlay:Destroy() end
            errorOverlay = nil
        end)
    end

    local function checkFunction(name, callback, ...)
        if type(callback) ~= "function" then
            reportGuiError(tostring(name or "Function") .. " is not a callable function")
            return false, "not a function"
        end
        local arguments = {...}
        local ok, result = xpcall(function()
            return callback(table.unpack(arguments))
        end, function(err)
            local message = tostring(err)
            reportGuiError(tostring(name or "Function") .. ": " .. message)
            return message
        end)
        return ok, result
    end

    -- Keybind Listener
    trackConnection(UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

        if capturingToggleKey then
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                toggleKeyCode = input.KeyCode
                capturingToggleKey = false
                configValues.toggleKey = toggleKeyCode.Name
                if toggleKeyButton and toggleKeyButton.Parent then
                    toggleKeyButton.Text = "  Toggle GUI Key: " .. toggleKeyCode.Name
                end
                notify({ Title = "Keybind Updated", Content = "GUI Toggle set to: " .. toggleKeyCode.Name })
            end
            return
        end

        if not gameProcessed and input.KeyCode == toggleKeyCode then
            screenGui.Enabled = not screenGui.Enabled
            isGuiOpen = screenGui.Enabled
        end
    end))

