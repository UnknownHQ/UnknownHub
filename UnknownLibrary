    -- Disable all features safely
    local function DisableAllFeatureStates()
        if disablingAll then return end
        disablingAll = true
        pcall(function()
            for key, _ in pairs(getgenv()) do
                if type(key) == "string" and (key:sub(1, 4) == "ENI_" or key:sub(1, 4) == "HUB_") then
                    getgenv()[key] = false
                end
            end
        end)

        for _, stopper in ipairs(featureStoppers) do
            pcall(function()
                if stopper then stopper() end
            end)
        end

        for _, setter in ipairs(allToggleSetters) do
            pcall(function()
                if setter then setter(false) end
            end)
        end

        local cleanup = getgenv().ENI_Cleanup or _G.ENI_Cleanup
        if cleanup then
            pcall(cleanup)
        end
        disablingAll = false
    end

