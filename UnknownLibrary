            utilityStatus.TextColor3 = isError and Color3.fromRGB(255, 110, 110) or Color3.fromRGB(140, 225, 165)
        end

        local function getCharacterHumanoid()
            local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            return character and character:FindFirstChildOfClass("Humanoid")
        end

        createButton(utilityTabPage, "Reset Character", function()
            local humanoid = getCharacterHumanoid()
            if humanoid then
                humanoid.Health = 0
                setUtilityStatus("Character reset", false)
            else
                setUtilityStatus("Humanoid not found", true)
            end
        end)

        local speedBox = createTextBox(utilityTabPage, "WalkSpeed Value (e.g. 32)", "32")
        local jumpBox = createTextBox(utilityTabPage, "JumpPower Value (e.g. 75)", "75")
        local speedOriginal, jumpOriginal
        local speedRun, jumpRun = 0, 0

        createToggle(utilityTabPage, "Lock WalkSpeed", false, function(enabled)
            speedRun = speedRun + 1
            local runId = speedRun
            local value = math.clamp(tonumber(speedBox.Text) or 16, 0, 500)
            if enabled then
                local humanoid = getCharacterHumanoid()
                speedOriginal = humanoid and humanoid.WalkSpeed or 16
                task.spawn(function()
                    while runId == speedRun and enabled and screenGui.Parent do
                        local character = LocalPlayer.Character
                        local currentHumanoid = character and character:FindFirstChildOfClass("Humanoid")
                        if currentHumanoid then currentHumanoid.WalkSpeed = value end
                        task.wait(0.15)
                    end
                end)
                setUtilityStatus("WalkSpeed locked at " .. tostring(value), false)
            elseif speedOriginal then
                local humanoid = getCharacterHumanoid()
                if humanoid then humanoid.WalkSpeed = speedOriginal end
                setUtilityStatus("WalkSpeed restored", false)
            end
        end)

        createToggle(utilityTabPage, "Lock JumpPower", false, function(enabled)
            jumpRun = jumpRun + 1
            local runId = jumpRun
            local value = math.clamp(tonumber(jumpBox.Text) or 50, 0, 500)
            if enabled then
                local humanoid = getCharacterHumanoid()
                jumpOriginal = humanoid and humanoid.JumpPower or 50
                task.spawn(function()
                    while runId == jumpRun and enabled and screenGui.Parent do
                        local character = LocalPlayer.Character
                        local currentHumanoid = character and character:FindFirstChildOfClass("Humanoid")
                        if currentHumanoid then
                            currentHumanoid.UseJumpPower = true
                            currentHumanoid.JumpPower = value
                        end
                        task.wait(0.15)
                    end
                end)
                setUtilityStatus("JumpPower locked at " .. tostring(value), false)
            elseif jumpOriginal then
                local humanoid = getCharacterHumanoid()
                if humanoid then
                    humanoid.UseJumpPower = true
                    humanoid.JumpPower = jumpOriginal
                end
                setUtilityStatus("JumpPower restored", false)
            end
        end)

        createSection(utilityTabPage, "Server & Teleport")

        createButton(utilityTabPage, "Rejoin Server", function()
            setUtilityStatus("Rejoining server...", false)
            pcall(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end)
        end)

        createButton(utilityTabPage, "Server Hop", function()
            task.spawn(function()
                setUtilityStatus("Searching for alternate servers...", false)
                local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Asc&limit=100"
                local ok, response = pcall(function() return game:HttpGet(url) end)
                if not ok or not response then
                    setUtilityStatus("Could not fetch server list", true)
                    return
                end
                local decodedOk, result = pcall(function() return HttpService:JSONDecode(response) end)
                if not decodedOk or not result or not result.data then
                    setUtilityStatus("Invalid server response", true)
                    return
                end
                for _, server in ipairs(result.data) do
                    if server.id and server.id ~= game.JobId and server.playing < server.maxPlayers then
                        setUtilityStatus("Found server (" .. server.playing .. "/" .. server.maxPlayers .. "), hopping...", false)
                        pcall(function()
                            TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
