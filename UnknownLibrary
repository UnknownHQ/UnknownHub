    local function registerThemeFrame(frm)
        if not frm then return end
        table.insert(themeFrames, frm)
        frm.BackgroundColor3 = currentThemeColor
    end

    local function registerThemeUpdater(callback)
        if type(callback) == "function" then
            table.insert(themeUpdaters, callback)
            pcall(callback, currentThemeColor)
        end
    end

    local function pruneDeadThemeReferences()
        local function pruneList(tbl, checkParent)
            local i = 1
            while i <= #tbl do
                local item = tbl[i]
                if not item or (checkParent and not item.Parent) then
                    table.remove(tbl, i)
                else
                    i = i + 1
                end
            end
        end
        pruneList(themeLabels, true)
        pruneList(themeStrokes, true)
        pruneList(themeFrames, true)
    end

    local function applyTheme(color)
        currentThemeColor = color
        pruneDeadThemeReferences()

        for _, label in ipairs(themeLabels) do
            if label and label.Parent then label.TextColor3 = currentThemeColor end
        end
        for _, stroke in ipairs(themeStrokes) do
            if stroke and stroke.Parent then stroke.Color = currentThemeColor end
        end
        for _, frame in ipairs(themeFrames) do
            if frame and frame.Parent then frame.BackgroundColor3 = currentThemeColor end
        end
        for _, updater in ipairs(themeUpdaters) do
            pcall(updater, currentThemeColor)
        end
    end

